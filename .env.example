# 複製成 .env 後填入實際值（.env 已在 .gitignore，不會進 repo）

# 表單的 API 網址：https://{server}.ragic.com/{account}/{tab}/{sheetIndex}
# 就是你瀏覽器打開該表單時的網址（去掉後面的參數）
RAGIC_SHEET_URL=https://ap7.ragic.com/youraccount/forms1/1

# API Key：Ragic 右上角頭像 → 個人設定 → 產生 API Key
RAGIC_API_KEY=your_api_key_here

# Markdown 欄位的 Field ID（數字），在表單設計模式點該欄位可以看到
RAGIC_FIELD_ID=1000123
