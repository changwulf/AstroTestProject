---
import { marked } from 'marked';
import { fetchRagicMarkdown } from '../lib/ragic';

// ===== Build time 執行：從 Ragic 撈 Markdown 欄位 =====
const ragic = await fetchRagicMarkdown();

const fallbackMarkdown = `## 這是示範內容（尚未連接 Ragic）

設定好 \`.env\` 裡的三個變數後重新 build，這個區塊就會換成 **Ragic 表單裡的 Markdown 欄位內容**。

支援的語法示範：

- 清單項目一
- 清單項目二

1. 有序清單
2. 第二點

> 引用區塊也可以用。

\`\`\`js
// 程式碼區塊
console.log('hello from Ragic');
\`\`\`

[連結](https://www.ragic.com) 和 *斜體*、**粗體** 都沒問題。`;

const source = ragic ? 'Ragic API' : '示範內容（未連接）';
const html = marked.parse(ragic?.markdown ?? fallbackMarkdown);
const builtAt = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>巧禾雲端工作室</title>
    <meta
      name="description"
      content="製造業數位化的翻譯者 — CRM、自動化與工作流程整合"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <span class="brand">巧禾雲端工作室</span>
        <nav>
          <a href="/">首頁</a>
          <a href="/blog" class="muted" title="之後再加">Blog</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="eyebrow">Ragic × Astro 串接測試</p>
        <h1>內容由 Ragic 管理，<br />頁面是純靜態輸出</h1>
        <p class="lead">
          下方灰框內的文字在 build time 從 Ragic API 取得，
          以 Markdown 撰寫、轉為 HTML 後直接編進靜態頁面。
        </p>
      </section>

      <!-- ===== Ragic Markdown 欄位渲染區 ===== -->
      <section class="cms-block">
        <div class="cms-meta">
          <span class="badge" data-live={ragic ? 'true' : 'false'}>
            資料來源：{source}
          </span>
          {ragic && <span class="muted">表單共 {ragic.recordCount} 筆，顯示最新一筆</span>}
          <span class="muted">Build 時間：{builtAt}</span>
        </div>
        <article class="prose" set:html={html} />
      </section>
    </main>

    <footer class="wrap site-footer">
      <p class="muted">© 2026 巧禾雲端工作室 · Astro + Ragic + Cloudflare Pages</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #fbfaf7;
    --ink: #23292e;
    --ink-soft: #6b7480;
    --line: #e3ded3;
    --accent: #1f6f54;
    --accent-soft: #e5f0ea;
    --card: #ffffff;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', system-ui, sans-serif;
    line-height: 1.7;
  }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .brand {
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    margin-left: 1.25rem;
    font-size: 0.95rem;
  }
  nav a:hover { color: var(--accent); }
  nav a:focus-visible,
  .prose :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .hero {
    padding: 3.5rem 0 2rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    line-height: 1.35;
    margin: 0 0 1rem;
    font-weight: 700;
  }
  .lead {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
    max-width: 34em;
  }

  .cms-block {
    margin: 2.5rem 0 4rem;
  }
  .cms-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.9rem;
    font-size: 0.85rem;
  }
  .badge {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-weight: 600;
  }
  .badge[data-live='false'] {
    background: #f3ede0;
    color: #8a6d1f;
  }
  .muted { color: var(--ink-soft); }

  .prose {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.75rem 2rem;
  }
  .prose :global(h2) { margin-top: 0; font-size: 1.35rem; }
  .prose :global(h3) { font-size: 1.1rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--ink-soft);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(pre) {
    background: #22272b;
    color: #e8edf2;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .prose :global(code) { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; }
  .prose :global(:not(pre) > code) {
    background: #f0ede4;
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose :global(img) { max-width: 100%; border-radius: 8px; }

  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
    padding-bottom: 2.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 540px) {
    .prose { padding: 1.25rem 1.1rem; }
  }
</style>
